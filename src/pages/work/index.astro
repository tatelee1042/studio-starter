---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Work — Tate Lee"
  description="An honest project template for Tate Lee's future accounting and business work."
>
  <section class="work-page" aria-labelledby="work-title">
    <p class="work-label">Work</p>
    <h1 id="work-title">Projects coming soon.</h1>
    <p class="work-intro">
      I’m preparing work that reflects my accounting studies. I’ll add projects when they are ready to share.
    </p>
    <a class="work-template-link" href="/work/first-project/">
      View the case-study structure <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>

<style>
  .work-page {
    min-height: var(--hero-min-height);
    display: grid;
    align-content: center;
    justify-items: start;
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .work-label {
    margin: 0 0 var(--space-lg);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .work-page h1 {
    max-width: var(--measure-hero);
    margin: 0;
    font-size: var(--text-section);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .work-intro {
    max-width: var(--measure-compact);
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .work-template-link {
    min-height: var(--space-xl);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
  }

  .work-template-link span {
    color: var(--color-action-secondary);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .work-template-link:hover span,
  .work-template-link:focus-visible span {
    transform: translateX(var(--space-2xs));
  }

  @media (prefers-reduced-motion: reduce) {
    .work-template-link span {
      transition: none;
    }
  }
</style>
