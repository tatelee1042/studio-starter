---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import crabNebula from '../assets/site/crab-nebula-chandra-ixpe.jpg';
---

<Base
  title="Tate Lee — Accounting internship portfolio"
  description="Tate Lee is a business student focused on accounting with a double major in Japanese, seeking an internship."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">Accounting + Japanese</p>
      <h1 id="hero-title">Business, accounting, and Japanese.</h1>
      <p class="hero-intro">I’m Tate Lee, a student seeking an accounting internship.</p>
      <div class="hero-actions" aria-label="Explore Tate Lee's portfolio">
        <a class="hero-action hero-action-primary" href="/about/">About me</a>
        <a class="hero-action hero-action-secondary" href="/work/">View work</a>
      </div>
    </div>
    <figure class="hero-art">
      <div class="hero-art-frame">
        <Image
          src={crabNebula}
          alt="The Crab Nebula's purple pulsar wind glowing inside blue and red filaments"
          loading="eager"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 48rem) 50vw, 100vw"
        />
      </div>
      <figcaption>
        Crab Nebula. X-ray: Chandra NASA/CXC/SAO and IXPE NASA/MSFC; optical: NASA/ESA/STScI.
      </figcaption>
    </figure>
  </section>

  <section class="home-section evidence" aria-labelledby="evidence-title">
    <div class="section-heading">
      <h2 id="evidence-title">What I bring</h2>
      <p>A focused foundation for an accounting internship.</p>
    </div>
    <ol class="evidence-list">
      <li>
        <span class="evidence-number" aria-hidden="true">01</span>
        <h3>Accounting focus</h3>
        <p>Studying business with a focus in accounting.</p>
      </li>
      <li>
        <span class="evidence-number" aria-hidden="true">02</span>
        <h3>Japanese double major</h3>
        <p>Building language skills alongside a business education.</p>
      </li>
      <li>
        <span class="evidence-number" aria-hidden="true">03</span>
        <h3>Internship goal</h3>
        <p>Seeking an opportunity to apply my accounting studies in a professional setting.</p>
      </li>
    </ol>
  </section>

  <section class="home-section background" aria-labelledby="background-title">
    <div class="background-heading">
      <h2 id="background-title">Business studies with a wider perspective.</h2>
      <a class="text-link" href="/about/">Read about my background <span aria-hidden="true">→</span></a>
    </div>
    <p>
      I’m a business student focused on accounting with a double major in Japanese. I’m building this portfolio to support my search for an internship.
    </p>
  </section>

  <section class="home-section work-preview" aria-labelledby="work-title">
    <div class="work-heading">
      <h2 id="work-title">Work</h2>
      <p>Projects coming soon.</p>
    </div>
    <div class="work-state">
      <p>I’m preparing work that reflects my accounting studies. I’ll add projects when they are ready to share.</p>
    </div>
  </section>

  <section class="home-cta" aria-labelledby="cta-title">
    <p class="home-cta-signal" aria-hidden="true"></p>
    <div>
      <h2 id="cta-title">I’m seeking an accounting internship.</h2>
      <p>If my background fits an opportunity on your team, I’d be glad to continue the conversation.</p>
    </div>
    <a class="hero-action hero-action-primary" href="mailto:tatelee2024@gmail.com">Email me</a>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: var(--hero-min-height);
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    overflow: hidden;
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent var(--space-2xs),
      var(--color-scanline) var(--space-2xs),
      var(--color-scanline) calc(var(--space-2xs) + 1px)
    );
    opacity: 0.35;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: var(--measure-body);
  }

  .hero-art {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--hero-art-max);
    margin: 0 auto;
  }

  .hero-art-frame {
    overflow: hidden;
  }

  .hero-art-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-art figcaption {
    max-width: var(--measure-caption);
    margin-top: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .home-section {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .section-heading h2,
  .background h2,
  .work-preview h2,
  .home-cta h2 {
    margin: 0;
    font-size: var(--text-section);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .section-heading p,
  .background p,
  .work-preview p,
  .home-cta p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .evidence-list {
    list-style: none;
    display: grid;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .evidence-list li {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .evidence-list li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: var(--space-xl);
    height: 1px;
    background: var(--color-accent);
  }

  .evidence-list li:nth-child(2)::before {
    background: var(--color-action-secondary);
  }

  .evidence-list li:nth-child(3)::before {
    background: var(--color-focus);
  }

  .evidence-number {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
  }

  .evidence-list li:nth-child(2) .evidence-number {
    color: var(--color-action-secondary);
  }

  .evidence-list li:nth-child(3) .evidence-number {
    color: var(--color-focus);
  }

  .evidence-list h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .evidence-list p {
    max-width: var(--measure-compact);
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .background,
  .work-preview {
    display: grid;
    gap: var(--space-xl);
  }

  .background-heading,
  .work-heading,
  .work-state {
    display: grid;
    align-content: start;
    gap: var(--space-lg);
  }

  .background > p,
  .work-state > p {
    max-width: var(--measure-compact);
    font-size: var(--text-lg);
  }

  .work-preview {
    position: relative;
  }

  .work-preview::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: var(--space-xl);
    width: var(--space-2xl);
    height: 1px;
    background: var(--color-deep-violet);
  }

  .text-link {
    width: fit-content;
    min-height: var(--space-xl);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
  }

  .text-link span {
    color: var(--color-action-secondary);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .text-link:hover span,
  .text-link:focus-visible span {
    transform: translateX(var(--space-2xs));
  }

  .home-cta {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    margin-bottom: var(--space-xl);
    padding: var(--space-xl);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    overflow: hidden;
  }

  .home-cta::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--space-3xl);
    height: 1px;
    background: var(--color-action-secondary);
  }

  .home-cta-signal {
    width: var(--space-sm);
    height: var(--space-sm);
    border-radius: 50%;
    background: var(--color-focus);
    box-shadow: 0 0 var(--space-md) var(--color-focus);
  }

  .home-cta > div {
    display: grid;
    gap: var(--space-md);
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-lg);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: var(--measure-hero);
    margin: 0;
    font-size: var(--text-hero);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 34ch;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .hero-action {
    min-height: var(--space-xl);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid;
    border-radius: var(--radius-action);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .hero-action-primary {
    color: var(--color-action-primary);
    border-color: var(--color-action-primary);
  }

  .hero-action-primary:hover,
  .hero-action-primary:focus-visible {
    color: var(--color-bg);
    background: var(--color-action-primary);
    border-color: var(--color-action-primary);
  }

  .hero-action-secondary {
    color: var(--color-action-secondary);
    border-color: var(--color-action-secondary);
  }

  .hero-action-secondary:hover,
  .hero-action-secondary:focus-visible {
    color: var(--color-bg);
    background: var(--color-action-secondary);
    border-color: var(--color-action-secondary);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: var(--space-2xl);
    }

    .hero-art {
      margin-right: 0;
    }

    .section-heading,
    .background,
    .work-preview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evidence-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .evidence-list li {
      padding-right: var(--space-lg);
    }

    .evidence-list li + li {
      padding-left: var(--space-lg);
      border-left: 1px solid var(--color-border);
    }

    .evidence-list li + li::before {
      left: var(--space-lg);
    }

    .home-cta {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--space-xl);
      padding: var(--space-2xl) var(--space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-action,
    .text-link span {
      transition: none;
    }
  }
</style>
